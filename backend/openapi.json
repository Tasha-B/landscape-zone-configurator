{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/plans": {
      "get": {
        "operationId": "plans_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every plan, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanSummaryResponse"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "plans"
        ]
      },
      "post": {
        "operationId": "plans_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlanDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new plan, without zones, at version 1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is invalid"
          }
        },
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plans/{id}": {
      "get": {
        "operationId": "plans_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The plan with its zones in legend order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a UUID"
          },
          "404": {
            "description": "No plan has this id"
          }
        },
        "tags": [
          "plans"
        ]
      },
      "patch": {
        "operationId": "plans_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePlanDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The changed plan with its zones, at the next version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a UUID, the body is invalid or changes nothing"
          },
          "404": {
            "description": "No plan has this id"
          },
          "409": {
            "description": "The plan has changed since the version sent; reload it"
          }
        },
        "tags": [
          "plans"
        ]
      },
      "delete": {
        "operationId": "plans_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The plan and its zones are deleted"
          },
          "400": {
            "description": "The id is not a UUID"
          },
          "404": {
            "description": "No plan has this id"
          }
        },
        "tags": [
          "plans"
        ]
      }
    }
  },
  "info": {
    "title": "Landscape Zone Configurator API",
    "description": "Floor plans and their zones",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "PlanSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "background": {
            "type": "string",
            "nullable": true
          },
          "zoneCount": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "background",
          "zoneCount",
          "updatedAt"
        ]
      },
      "RectShape": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "rect"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "rx": {
            "type": "number",
            "minimum": 0,
            "description": "Corner radius"
          }
        },
        "required": [
          "kind",
          "x",
          "y",
          "width",
          "height",
          "rx"
        ]
      },
      "CircleShape": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "circle"
            ]
          },
          "cx": {
            "type": "number"
          },
          "cy": {
            "type": "number"
          },
          "r": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "required": [
          "kind",
          "cx",
          "cy",
          "r"
        ]
      },
      "PolygonShape": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "polygon"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "description": "At least 3 points; curves are approximated by points"
          }
        },
        "required": [
          "kind",
          "points"
        ]
      },
      "ZoneType": {
        "type": "string",
        "enum": [
          "reception",
          "meeting-room",
          "open-floor",
          "break-room",
          "signature-corner",
          "custom"
        ]
      },
      "ZoneLabel": {
        "type": "object",
        "properties": {
          "dx": {
            "type": "number",
            "description": "Offset of the name from the shape center"
          },
          "dy": {
            "type": "number"
          },
          "fontSize": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "areaDy": {
            "type": "number",
            "description": "Offset of the area caption below the name; the frontend default is 22"
          }
        },
        "required": [
          "dx",
          "dy"
        ]
      },
      "ZoneContent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tagline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "tagline",
          "recommendation",
          "rationale"
        ]
      },
      "ZoneContentByLang": {
        "type": "object",
        "properties": {
          "en": {
            "$ref": "#/components/schemas/ZoneContent"
          },
          "ru": {
            "$ref": "#/components/schemas/ZoneContent"
          }
        },
        "required": [
          "en",
          "ru"
        ]
      },
      "ZoneResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ZoneType"
              }
            ]
          },
          "shape": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RectShape"
              },
              {
                "$ref": "#/components/schemas/CircleShape"
              },
              {
                "$ref": "#/components/schemas/PolygonShape"
              }
            ],
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "rect": "#/components/schemas/RectShape",
                "circle": "#/components/schemas/CircleShape",
                "polygon": "#/components/schemas/PolygonShape"
              }
            }
          },
          "color": {
            "type": "string",
            "description": "Marker, hover tint and legend swatch"
          },
          "zIndex": {
            "type": "integer",
            "description": "Paint and tab order"
          },
          "hitPadding": {
            "type": "integer",
            "nullable": true,
            "description": "null: the frontend default (20)"
          },
          "label": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ZoneLabel"
              }
            ]
          },
          "version": {
            "type": "integer",
            "description": "Increases with every change (optimistic concurrency)"
          },
          "content": {
            "$ref": "#/components/schemas/ZoneContentByLang"
          }
        },
        "required": [
          "id",
          "type",
          "shape",
          "color",
          "zIndex",
          "hitPadding",
          "label",
          "version",
          "content"
        ]
      },
      "PlanResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "viewBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[minX, minY, width, height]"
          },
          "pxPerMeter": {
            "type": "number"
          },
          "background": {
            "type": "string",
            "nullable": true,
            "description": "\"demo-office\": the demo office's artwork; null: a blank sheet"
          },
          "version": {
            "type": "integer",
            "description": "Increases with every change (optimistic concurrency)"
          },
          "zones": {
            "description": "Legend order",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ZoneResponse"
            }
          }
        },
        "required": [
          "id",
          "name",
          "viewBox",
          "pxPerMeter",
          "background",
          "version",
          "zones"
        ]
      },
      "CreatePlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "viewBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[minX, minY, width, height]"
          },
          "pxPerMeter": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "description": "viewBox units per meter"
          },
          "background": {
            "type": "string",
            "enum": [
              "demo-office"
            ],
            "nullable": true,
            "description": "null or left out: a blank sheet"
          }
        },
        "required": [
          "name",
          "viewBox",
          "pxPerMeter"
        ]
      },
      "UpdatePlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "viewBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[minX, minY, width, height]"
          },
          "pxPerMeter": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "description": "viewBox units per meter"
          },
          "background": {
            "type": "string",
            "enum": [
              "demo-office"
            ],
            "nullable": true,
            "description": "null or left out: a blank sheet"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "The version the change is based on; 409 if it is stale"
          }
        },
        "required": [
          "version"
        ]
      }
    }
  }
}
