# Copy to backend/.env for local development: cp .env.example .env
# The API validates these at startup and refuses to start if one is invalid.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# PostgreSQL connection string. Matches the db service in docker-compose.yml.
# Only phase 3 (Prisma) connects; it is required already.
DATABASE_URL=postgresql://lzc:lzc@localhost:5432/lzc
