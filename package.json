{
  "name": "landscape-zone-configurator",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev:frontend": "npm run dev -w frontend --",
    "dev:backend": "npm run start:dev -w backend --",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend --",
    "db:deploy": "npm run db:deploy -w backend --",
    "db:seed": "npm run db:seed -w backend --",
    "db:studio": "npm run db:studio -w backend --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
